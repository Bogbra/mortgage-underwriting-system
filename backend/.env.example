# Copy to .env and fill in real values for a non-demo run.
# Every value below has a safe, offline default (see underwriting/config.py) —
# the service runs end-to-end with none of this set, using the deterministic
# fake LLM and fake embeddings.

# --- LLM provider ---------------------------------------------------------
# fake (default, offline) | openai | anthropic
LLM_PROVIDER=fake
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Embeddings (RAG policy retrieval) ------------------------------------
# fake (default, offline, hash-based — retrieval is not semantically meaningful)
# openai (real semantic retrieval, requires OPENAI_API_KEY)
EMBEDDING_PROVIDER=fake
EMBEDDING_MODEL=text-embedding-3-small

# --- Storage ---------------------------------------------------------------
DATABASE_URL=sqlite:///./data/underwriting.db
CHROMA_PERSIST_DIR=./data/chroma
POLICY_DOCUMENT_PATH=./data/policies/underwriting_policies.md

# --- API / auth --------------------------------------------------------------
# Replace both before deploying anywhere reachable — see docs/adr/0005.
API_BEARER_TOKEN=dev-local-token
REVIEWER_BEARER_TOKEN=dev-reviewer-token
CORS_ALLOW_ORIGINS=["http://localhost:3000"]

# --- Guardrails --------------------------------------------------------------
HUMAN_REVIEW_RISK_THRESHOLD=65
